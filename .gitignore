node_modules/
tests/output/
tests/fixtures/*/

# The Freemius SDK ships inside the plugin, so it is tracked. Everything else
# in vendor/ is ignored.
vendor/*
!vendor/freemius/

dist/
*.zip
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local wp-env overrides — holds the Freemius secret key, never commit
.wp-env.override.json
